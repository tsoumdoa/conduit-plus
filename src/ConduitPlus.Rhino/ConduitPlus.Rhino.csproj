<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>ConduitPlus.Rhino</AssemblyName>
    <AssemblyTitle>conduit-plus</AssemblyTitle>
    <Description>Conduit+ viewport cards for Rhino and Grasshopper</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ConduitPlus.Core/ConduitPlus.Core.csproj" />
    <PackageReference Include="RhinoCommon" Version="$(RhinoApiVersion)" ExcludeAssets="runtime" />
    <Reference Update="RhinoCommon"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
