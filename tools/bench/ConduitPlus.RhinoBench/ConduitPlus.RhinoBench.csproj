  <ItemGroup><PackageReference Include="RhinoCommon" Version="$(RhinoApiVersion)" ExcludeAssets="runtime" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="$(RhinoApiVersion)" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../src/ConduitPlus.Display/ConduitPlus.Display.csproj" />
    <ProjectReference Include="../../../src/ConduitPlus.Grasshopper/ConduitPlus.Grasshopper.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="ConduitPlus.Grasshopper">
      <HintPath>../../../src/ConduitPlus.Grasshopper/bin/$(Configuration)/$(TargetFramework)/ConduitPlus.Grasshopper.gha</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../../src/ConduitPlus.Rhino/ConduitPlus.Rhino.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
</Project>
